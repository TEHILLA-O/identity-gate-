    "UPDATE_PASSWORD",
    "VERIFY_EMAIL",
    "CLIENT_LOGIN",
    "CLIENT_LOGIN_ERROR"
  ],
  "internationalizationEnabled": false,
  "scimApiEnabled": true,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
